[Unit]
Description=Caddy public ACME TLS reverse proxy for Dex
After=network-online.target dex-storage-init.service dex.service
Wants=network-online.target dex.service
Requires=dex-storage-init.service

[Container]
Image=docker.io/library/caddy@sha256:c802bf2721a427e961b9fd6a194c3888a180de9990b43f8530a02bd6be017e17
ContainerName=caddy
Network=host
DropCapability=all
AddCapability=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ReadOnly=true
ReadOnlyTmpfs=true
Memory=256m
PidsLimit=128
Volume=/etc/caddy/Caddyfile:/etc/caddy/Caddyfile:ro,Z
Volume=/var/lib/dex/caddy/data:/data:Z
Volume=/var/lib/dex/caddy/config:/config:Z

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
